APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:TXxWp2dyrKcIavh9vTjXa29uUZ7C+T6NvBJ4/QkMxbo=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quality-assurance-system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

# --------------------------------------------------------------------------
# MINIO & STORAGE CONFIGURATION
# --------------------------------------------------------------------------
# Sesuaikan bagian ini dengan akun MinIO kamu
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://127.0.0.1:9001
MINIO_BUCKET=spmi-storage
MINIO_USE_PATH_STYLE_ENDPOINT=true

# Mapping ke AWS variabel (agar driver S3 Laravel bisa baca)
AWS_ACCESS_KEY_ID=${MINIO_KEY}
AWS_SECRET_ACCESS_KEY=${MINIO_SECRET}
AWS_DEFAULT_REGION=${MINIO_REGION}
AWS_BUCKET=${MINIO_BUCKET}
AWS_URL=${MINIO_ENDPOINT}/${MINIO_BUCKET}
AWS_ENDPOINT=${MINIO_ENDPOINT}
AWS_USE_PATH_STYLE_ENDPOINT=${MINIO_USE_PATH_STYLE_ENDPOINT}

# --------------------------------------------------------------------------
# MAIL & OTHERS
# --------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"